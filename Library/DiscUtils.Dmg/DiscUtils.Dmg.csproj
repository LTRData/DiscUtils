<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>.NET support for reading Apple DMG/UDIF disk images and decompressing supported image data.</Description>
    <Authors>Kenneth Bell;LordMike;quamotion;Olof Lagerkvist</Authors>
    <PackageTags>DiscUtils;DiskImage;DMG;UDIF;Apple</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiscUtils.Core\DiscUtils.Core.csproj" />

	<PackageReference Include="lzfse-net" Version="*" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))" />
	<PackageReference Include="LzfseSharp" Version="*" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))" />
  </ItemGroup>

</Project>
