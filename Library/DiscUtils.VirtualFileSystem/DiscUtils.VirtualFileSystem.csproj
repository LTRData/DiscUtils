<Project Sdk="Microsoft.NET.Sdk">
  

  <PropertyGroup>
    <Description>Composable .NET virtual filesystem trees, TAR and ZIP filesystem readers, and a TAR image builder through DiscUtils abstractions.</Description>
    <Authors>Olof Lagerkvist</Authors>
    <PackageTags>DiscUtils;Filesystem;VirtualFileSystem;VFS;Streams;TAR;ZIP</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiscUtils.Core\DiscUtils.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.StartsWith(`net4`))' And '$(TargetFramework.CompareTo(`net46`))' &gt;= 0">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
